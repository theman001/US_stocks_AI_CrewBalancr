# ─────────────────────────────────────────────────────────────────────────────
# OMV8 배포: 아래를 OMV-compose "Environment" 탭에 그대로 (git 미커밋). deploy/DEPLOY.md
# 로컬 개발: `uv run ...` 은 이 파일 안 읽음 — 필요한 것만 셸 export 하거나 별도 .env.
# ─────────────────────────────────────────────────────────────────────────────

# ─── 배포 (compose 가 참조) ───
AEGIS_DATA=/srv/dev-disk-by-uuid-XXXX/appdata/aegisvest   # OMV 공유폴더 절대경로 (필수)
TZ=Asia/Seoul
AEGIS_MEM=4g              # 컨테이너 메모리 상한 (bge-m3 상주). RAM 8GB↑ 권장, 미만이면 낮추고 swap

# ─── 실행 모드 ───
MODE=paper               # paper | live
DRY_RUN=false            # 가동 = false. true 면 state/ 무접촉·미체결·알림·회상 스킵 (리허설)
UNIVERSE=combined        # SP500 | NASDAQ100 | combined
LOG_LEVEL=INFO

# ─── LLM: DeepSeek (LiteLLM 경유) ───
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
MODEL=deepseek/deepseek-chat    # 에이전트별 temperature 는 config/agents.yaml

# ─── 금융 데이터 API ───
FRED_API_KEY=xxxxxxxx    # FRED (매크로, 무료 — https://fred.stlouisfed.org/docs/api/api_key.html)
FMP_API_KEY=             # Financial Modeling Prep (선택 — 없으면 yfinance 폴백)
MANUAL_ISM_PMI=          # ISM PMI 수동 입력 (유료 API 없을 때, 있으면 최우선)

# ─── 알림 (Mattermost 인커밍 웹훅) ───
MATTERMOST_WEBHOOK_URL=  # 미설정 시 알림 스킵, outputs/ 파일만. 채널 고정 → [aegis-*] 태그로 구분
MM_WEBHOOK_RESEARCH=     # (선택) #aegis-research 전용 웹훅 — 애널리스트 노트
MM_WEBHOOK_DECISIONS=    # (선택) #aegis-decisions — PM·Risk·CIO
MM_WEBHOOK_ALERTS=       # (선택) #aegis-alerts — 위기·주간 요약

# ─── 페이퍼 브로커 ───
CACHE_TTL_HOURS=24
PAPER_COMMISSION_PCT=0.001       # 나무증권 온라인 해외주식 ~0.07~0.25%
PAPER_FX_SPREAD_PCT=0.005        # KRW→USD 환전 스프레드
MONTHLY_CONTRIBUTION_KRW=100000  # 적금형 월 납입 (0 = 납입 없음)
