# ─── 실행 모드 ───
MODE=paper                     # paper | live
DRY_RUN=true                   # true면 주문 리포트만, 실행 안 함
UNIVERSE=combined              # SP500 | NASDAQ100 | combined
LOG_LEVEL=INFO
TZ=Asia/Seoul

# ─── 경로 (OMV 배포 시 볼륨 루트) ───
AEGIS_DATA=/srv/dev-disk-by-uuid-XXXX/appdata/aegisvest
STATE_DIR=./state
OUTPUT_DIR=./outputs
CACHE_DIR=./data/cache

# ─── LLM: DeepSeek (LiteLLM 경유, 3a-9 이후) ───
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
MODEL=deepseek/deepseek-chat
REASONER_MODEL=deepseek/deepseek-reasoner
LLM_TEMPERATURE=0.0
LLM_MAX_RPM=20

# ─── 금융 데이터 API ───
FMP_API_KEY=xxxxxxxx           # Financial Modeling Prep (재무제표·스크리너)
FRED_API_KEY=xxxxxxxx          # FRED (매크로, 무료)
NASDAQ_DATA_LINK_API_KEY=      # Sharadar 백테스트 최종검증 (일회성, 평소 비움)

# 복합 경기축 FRED 시리즈 (기본값 있음, 필요시 override)
FRED_SERIES_WEI=WEI
FRED_SERIES_CLAIMS=IC4WSA
FRED_SERIES_HY_OAS=BAMLH0A0HYM2
FRED_SERIES_YC=T10Y3M

# ─── ISM PMI 수동 입력 (유료 API 없을 때, 있으면 최우선) ───
MANUAL_ISM_PMI=
MANUAL_ISM_PMI_ASOF=

# ─── 알림 (Mattermost 인커밍 웹훅) ───
MATTERMOST_WEBHOOK_URL=        # 미설정 시 알림 스킵, outputs/ 파일만
# 기본 웹훅은 채널 고정 → 모든 알림이 그 채널로 (텍스트에 [aegis-alerts] 등 태그).
# 채널을 분리하려면 채널별 웹훅 3개 생성 후 아래 설정 (있는 것만 라우팅):
MM_WEBHOOK_RESEARCH=           # #aegis-research (애널리스트 노트)
MM_WEBHOOK_DECISIONS=          # #aegis-decisions (PM·Risk·CIO)
MM_WEBHOOK_ALERTS=             # #aegis-alerts (위기·주간 요약)

# ─── 캐시 / 페이퍼 브로커 ───
CACHE_TTL_HOURS=24
PAPER_COMMISSION_PCT=0.001     # 나무증권 온라인 해외주식 ~0.07~0.25%
PAPER_FX_SPREAD_PCT=0.005      # KRW→USD 환전 스프레드
MONTHLY_CONTRIBUTION_KRW=100000  # 적금형 월 납입 (0 = 납입 없음)

# ─── 안전장치 ───
MAX_HIGH_RISK_EXPOSURE=0.20
